.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 司机信息区域 */
.driver-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.driver-info {
  display: flex;
  align-items: center;
}

.driver-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
}

.driver-detail {
  display: flex;
  flex-direction: column;
}

.driver-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.driver-license {
  font-size: 26rpx;
  color: #999;
}

/* 位置信息 */
.location-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.location-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.location-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.location-dot.start {
  background-color: #93da5f;
}

.location-dot.end {
  background-color: #48b6fc;
}

.location-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.location-label {
  font-size: 26rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 时间信息 */
.time-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.time-text {
  font-size: 28rpx;
  color: #999;
}

/* 费用明细 */
.fee-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.fee-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.fee-list {
  display: flex;
  flex-direction: column;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.fee-item:last-child {
  border-bottom: none;
}

.fee-label {
  font-size: 28rpx;
  color: #666;
}

.fee-value {
  font-size: 28rpx;
  color: #333;
}

/* 评价详情区域 */
.comment-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.comment-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.comment-stars {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.star {
  font-size: 48rpx;
  margin: 0 10rpx;
}

.comment-remark {
  font-size: 28rpx;
  color: #666;
}

/* 评价按钮区域 */
.comment-btn-section {
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.btn-comment {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

/* 底部按钮区域 */
.bottom-section {
  padding: 20rpx 0;
}

.btn-back {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #f0f0f0;
  color: #666;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}