.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

.account-section {
  background-color: #fff;
  padding: 30rpx;
}

.account-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.account-row:last-child {
  margin-bottom: 0;
}

.account-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.value {
  font-size: 36rpx;
  font-weight: bold;
}

.value.orange {
  color: #ff6600;
}

.value.green {
  color: #00c853;
}

.value.grey {
  color: #999;
}

.divider {
  height: 20rpx;
  background-color: #f5f5f5;
}

.section-title {
  background-color: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.detail-list {
  background-color: #fff;
  height: calc(100vh - 400rpx);
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.trade-type {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.content {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.detail-right {
  display: flex;
  align-items: center;
}

.amount {
  font-size: 32rpx;
  font-weight: bold;
}

.amount.income {
  color: #00c853;
}

.amount.expense {
  color: #ff6600;
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 提现按钮区域 - 固定在底部 */
.withdraw-btn-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-withdraw {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}