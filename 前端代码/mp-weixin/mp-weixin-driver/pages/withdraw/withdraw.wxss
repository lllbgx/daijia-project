.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

.available-section {
  background-color: #fff;
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.available-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.available-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #07c160;
}

.input-section {
  margin-top: 20rpx;
  background-color: #fff;
  padding: 30rpx;
}

.input-item {
  display: flex;
  flex-direction: column;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.input-row {
  display: flex;
  align-items: center;
}

.yuan {
  font-size: 48rpx;
  color: #333;
  margin-right: 20rpx;
}

.input {
  flex: 1;
  font-size: 48rpx;
  color: #333;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-section {
  padding: 60rpx 30rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.btn-withdraw {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.btn-withdraw[disabled] {
  background-color: #ccc;
  color: #fff;
}